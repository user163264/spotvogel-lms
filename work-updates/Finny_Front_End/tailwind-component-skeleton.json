{
  "components": {
    "buttons": {
      "primary": {
        "description": "Primary action button with brand color",
        "baseClasses": "font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2",
        "variants": {
          "default": {
            "classes": "bg-blue-600 text-white hover:bg-blue-700 focus:ring-blue-500"
          },
          "small": {
            "classes": "py-1 px-3 text-sm"
          },
          "medium": {
            "classes": "py-2 px-4 text-base"
          },
          "large": {
            "classes": "py-3 px-6 text-lg"
          }
        }
      },
      "secondary": {
        "description": "Secondary action button with subtle styling",
        "baseClasses": "font-medium rounded-md border transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2",
        "variants": {
          "default": {
            "classes": "bg-white text-gray-700 border-gray-300 hover:bg-gray-50 focus:ring-blue-500"
          },
          "small": {
            "classes": "py-1 px-3 text-sm"
          },
          "medium": {
            "classes": "py-2 px-4 text-base"
          },
          "large": {
            "classes": "py-3 px-6 text-lg"
          }
        }
      },
      "danger": {
        "description": "Danger action button for destructive actions",
        "baseClasses": "font-medium rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2",
        "variants": {
          "default": {
            "classes": "bg-red-600 text-white hover:bg-red-700 focus:ring-red-500"
          },
          "small": {
            "classes": "py-1 px-3 text-sm"
          },
          "medium": {
            "classes": "py-2 px-4 text-base"
          },
          "large": {
            "classes": "py-3 px-6 text-lg"
          }
        }
      }
    },
    "cards": {
      "basic": {
        "description": "Basic card container for content",
        "baseClasses": "bg-white rounded-lg shadow overflow-hidden",
        "variants": {
          "default": {
            "classes": ""
          },
          "withPadding": {
            "classes": "p-4"
          },
          "withLargePadding": {
            "classes": "p-6"
          },
          "withHeader": {
            "classes": "divide-y divide-gray-200"
          }
        }
      },
      "interactive": {
        "description": "Interactive card with hover state",
        "baseClasses": "bg-white rounded-lg shadow overflow-hidden transition-all",
        "variants": {
          "default": {
            "classes": "hover:shadow-md"
          },
          "clickable": {
            "classes": "cursor-pointer hover:shadow-md"
          }
        }
      }
    },
    "forms": {
      "input": {
        "description": "Text input field",
        "baseClasses": "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
        "variants": {
          "default": {
            "classes": "py-2 px-3"
          },
          "error": {
            "classes": "border-red-300 text-red-900 placeholder-red-300 focus:border-red-500 focus:ring-red-500"
          },
          "disabled": {
            "classes": "bg-gray-100 cursor-not-allowed"
          }
        }
      },
      "select": {
        "description": "Dropdown select field",
        "baseClasses": "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
        "variants": {
          "default": {
            "classes": "py-2 px-3"
          },
          "error": {
            "classes": "border-red-300 text-red-900 focus:border-red-500 focus:ring-red-500"
          },
          "disabled": {
            "classes": "bg-gray-100 cursor-not-allowed"
          }
        }
      },
      "textarea": {
        "description": "Multi-line text input",
        "baseClasses": "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
        "variants": {
          "default": {
            "classes": "py-2 px-3"
          },
          "error": {
            "classes": "border-red-300 text-red-900 placeholder-red-300 focus:border-red-500 focus:ring-red-500"
          },
          "disabled": {
            "classes": "bg-gray-100 cursor-not-allowed"
          }
        }
      },
      "checkbox": {
        "description": "Checkbox input",
        "baseClasses": "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500",
        "variants": {
          "default": {
            "classes": ""
          },
          "disabled": {
            "classes": "bg-gray-100 cursor-not-allowed"
          }
        }
      },
      "radio": {
        "description": "Radio button input",
        "baseClasses": "h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500",
        "variants": {
          "default": {
            "classes": ""
          },
          "disabled": {
            "classes": "bg-gray-100 cursor-not-allowed"
          }
        }
      },
      "label": {
        "description": "Form field label",
        "baseClasses": "block text-sm font-medium text-gray-700",
        "variants": {
          "default": {
            "classes": ""
          },
          "required": {
            "classes": "after:content-['*'] after:ml-0.5 after:text-red-500"
          },
          "error": {
            "classes": "text-red-700"
          }
        }
      },
      "helpText": {
        "description": "Helper text below form fields",
        "baseClasses": "mt-1 text-sm",
        "variants": {
          "default": {
            "classes": "text-gray-500"
          },
          "error": {
            "classes": "text-red-600"
          }
        }
      }
    },
    "exercise": {
      "container": {
        "description": "Container for exercise components",
        "baseClasses": "border rounded-lg overflow-hidden bg-white",
        "variants": {
          "default": {
            "classes": "shadow-sm"
          },
          "interactive": {
            "classes": "shadow"
          }
        }
      },
      "header": {
        "description": "Exercise header with instructions",
        "baseClasses": "px-4 py-3 bg-gray-50 border-b",
        "variants": {
          "default": {
            "classes": ""
          },
          "withActions": {
            "classes": "flex items-center justify-between"
          }
        }
      },
      "content": {
        "description": "Main exercise content area",
        "baseClasses": "p-4",
        "variants": {
          "default": {
            "classes": ""
          },
          "withGap": {
            "classes": "space-y-4"
          }
        }
      },
      "footer": {
        "description": "Exercise footer with actions",
        "baseClasses": "px-4 py-3 bg-gray-50 border-t flex items-center justify-end space-x-3",
        "variants": {
          "default": {
            "classes": ""
          }
        }
      },
      "matching": {
        "description": "Matching exercise specific components",
        "item": {
          "description": "Container for a matching item",
          "baseClasses": "flex flex-col md:flex-row md:items-center mb-4 gap-2",
          "variants": {
            "default": {
              "classes": ""
            }
          }
        },
        "itemText": {
          "description": "Text display for matching item",
          "baseClasses": "text-gray-900 font-medium",
          "variants": {
            "default": {
              "classes": "md:w-1/3"
            }
          }
        },
        "itemDropdown": {
          "description": "Dropdown for matching selection",
          "baseClasses": "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500",
          "variants": {
            "default": {
              "classes": "md:w-2/3"
            },
            "correct": {
              "classes": "border-green-300 bg-green-50 text-green-900"
            },
            "incorrect": {
              "classes": "border-red-300 bg-red-50 text-red-900"
            }
          }
        }
      },
      "multipleChoice": {
        "description": "Multiple choice exercise specific components",
        "option": {
          "description": "Container for a multiple choice option",
          "baseClasses": "relative flex items-start py-2",
          "variants": {
            "default": {
              "classes": ""
            },
            "withBorder": {
              "classes": "border-b border-gray-200 last:border-b-0"
            }
          }
        },
        "optionInput": {
          "description": "Radio input for multiple choice option",
          "baseClasses": "h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500",
          "variants": {
            "default": {
              "classes": "mt-0.5"
            }
          }
        },
        "optionLabel": {
          "description": "Label for multiple choice option",
          "baseClasses": "ml-3 text-sm",
          "variants": {
            "default": {
              "classes": "text-gray-700"
            },
            "correct": {
              "classes": "text-green-700"
            },
            "incorrect": {
              "classes": "text-red-700"
            }
          }
        }
      },
      "fillInBlank": {
        "description": "Fill in the blank exercise specific components",
        "container": {
          "description": "Container for fill in the blank content",
          "baseClasses": "prose max-w-none",
          "variants": {
            "default": {
              "classes": ""
            }
          }
        },
        "input": {
          "description": "Input field for filling in the blank",
          "baseClasses": "inline-block border-b-2 border-gray-300 focus:border-blue-500 focus:outline-none px-1",
          "variants": {
            "default": {
              "classes": "min-w-[100px] text-center"
            },
            "correct": {
              "classes": "border-green-500 bg-green-50"
            },
            "incorrect": {
              "classes": "border-red-500 bg-red-50"
            }
          }
        }
      },
      "feedback": {
        "description": "Exercise feedback display",
        "baseClasses": "mt-4 p-3 rounded-md",
        "variants": {
          "success": {
            "classes": "bg-green-50 border border-green-200"
          },
          "error": {
            "classes": "bg-red-50 border border-red-200"
          },
          "info": {
            "classes": "bg-blue-50 border border-blue-200"
          }
        }
      }
    },
    "navigation": {
      "sidebar": {
        "description": "Sidebar navigation container",
        "baseClasses": "flex flex-col w-64 bg-white border-r",
        "variants": {
          "default": {
            "classes": ""
          },
          "compact": {
            "classes": "w-20"
          }
        }
      },
      "sidebarItem": {
        "description": "Sidebar navigation item",
        "baseClasses": "group flex items-center px-3 py-2 text-sm font-medium rounded-md",
        "variants": {
          "default": {
            "classes": "text-gray-600 hover:bg-gray-50 hover:text-gray-900"
          },
          "active": {
            "classes": "bg-gray-100 text-gray-900"
          }
        }
      },
      "sidebarSection": {
        "description": "Sidebar section grouping",
        "baseClasses": "px-3 mt-5 mb-3",
        "variants": {
          "default": {
            "classes": ""
          }
        }
      },
      "sidebarHeading": {
        "description": "Sidebar section heading",
        "baseClasses": "px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider",
        "variants": {
          "default": {
            "classes": ""
          }
        }
      }
    },
    "layout": {
      "container": {
        "description": "Main content container",
        "baseClasses": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
        "variants": {
          "default": {
            "classes": ""
          },
          "narrow": {
            "classes": "max-w-3xl"
          }
        }
      },
      "section": {
        "description": "Content section",
        "baseClasses": "py-6",
        "variants": {
          "default": {
            "classes": ""
          },
          "withBorder": {
            "classes": "border-b border-gray-200"
          }
        }
      },
      "grid": {
        "description": "Grid layout container",
        "baseClasses": "grid gap-6",
        "variants": {
          "cols1": {
            "classes": "grid-cols-1"
          },
          "cols2": {
            "classes": "grid-cols-1 md:grid-cols-2"
          },
          "cols3": {
            "classes": "grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
          },
          "cols4": {
            "classes": "grid-cols-1 md:grid-cols-2 lg:grid-cols-4"
          }
        }
      }
    },
    "feedback": {
      "alert": {
        "description": "Alert message",
        "baseClasses": "rounded-md p-4",
        "variants": {
          "info": {
            "classes": "bg-blue-50 text-blue-700"
          },
          "success": {
            "classes": "bg-green-50 text-green-700"
          },
          "warning": {
            "classes": "bg-yellow-50 text-yellow-700"
          },
          "error": {
            "classes": "bg-red-50 text-red-700"
          }
        }
      },
      "toast": {
        "description": "Toast notification",
        "baseClasses": "p-4 rounded-md shadow-lg max-w-sm w-full fixed top-4 right-4 z-50 transform transition-all duration-300",
        "variants": {
          "info": {
            "classes": "bg-blue-500 text-white"
          },
          "success": {
            "classes": "bg-green-500 text-white"
          },
          "warning": {
            "classes": "bg-yellow-500 text-white"
          },
          "error": {
            "classes": "bg-red-500 text-white"
          }
        }
      }
    }
  }
}
